# --- Vercel (Project → Settings → Environment Variables) ---
# Required for production:
# NEXT_PUBLIC_ANOMALY_API_URL=https://salmeida-bottle-anomaly-detection.hf.space

# Hugging Face Space — POST /predict (no trailing slash)
NEXT_PUBLIC_ANOMALY_API_URL=https://salmeida-bottle-anomaly-detection.hf.space

# Optional aliases
# NEXT_PUBLIC_API_BASE_URL=
# NEXT_PUBLIC_VITE_API_BASE_URL=

# Optional: allow local demo fallback when prediction fails
# NEXT_PUBLIC_ALLOW_DEMO_FALLBACK=false

# Optional: log bbox coordinate conversion in browser console
# NEXT_PUBLIC_DEBUG_BBOX=true

# Supported API categories: bottle, capsule, hazelnut, metal_nut, pill, screw, zipper
# Default category in UI: bottle (see src/config/api-categories.ts)
