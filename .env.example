# Inference runs in the browser via onnxruntime-web — no API URL is required.
# The model, its error profile and the WebAssembly runtime are served from public/.

# Optional: record labeled synthetic results when an inspection fails.
# NEXT_PUBLIC_ALLOW_DEMO_FALLBACK=false

# Optional: verbose bounding-box layout logs in the browser console.
# NEXT_PUBLIC_DEBUG_BBOX=true
